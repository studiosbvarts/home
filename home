</main>

<footer>
  <div class="wrap footer-row">
    <div class="footer-copy"><strong style="color:#f5f5f3;letter-spacing:.12em;">BVARTS</strong><br>TECNOLOGIA · FORMAÇÃO · SOLUÇÕES<br></div>
    <div class="socials" aria-label="Redes sociais">
